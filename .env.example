# ------------------ App / Database (Railway) ------------------
# Create a PostgreSQL service in Railway and paste its connection string here.
# PORT is provided automatically by Railway; APP_URL is your public domain
# (used for payment redirect_url / IPN callbacks).
DATABASE_URL=postgres://user:password@host:5432/xena
APP_URL=https://your-app.up.railway.app
PORT=3000

# ------------------ Flutterwave (NGN deposits) ------------------
# Dashboard -> Settings -> API Keys. Webhook URL to set in Flutterwave:
#   https://<your-domain>/api/flutterwave/webhook
# FLUTTERWAVE_WEBHOOK_SECRET_HASH must match the "Secret hash" configured
# in Flutterwave Settings -> Webhooks.
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
VITE_FLUTTERWAVE_PUBLIC_KEY=

# ------------------ NOWPayments (crypto deposits) ------------------
# Dashboard -> API settings. IPN URL to set in NOWPayments:
#   https://<your-domain>/api/crypto/ipn
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_PUBLIC_KEY=
NOWPAYMENTS_IPN_SECRET=